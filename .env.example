# Discord-LLM 환경 변수 예제 파일
# 실제 사용 시 이 파일을 .env로 복사하고 값을 수정하세요

# Discord Bot 설정
DISCORD_TOKEN=your_discord_bot_token_here

# LLM 선택 설정
# local, openai, anthropic 중 하나를 선택하세요
LLM_PROVIDER=local

# 외부 LLM API 설정 (LLM_PROVIDER가 local이 아닐 경우 사용)
# OpenAI API 설정 (LLM_PROVIDER=openai일 때)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o  # 또는 gpt-4-turbo, gpt-3.5-turbo 등

# Anthropic API 설정 (LLM_PROVIDER=anthropic일 때)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229  # 또는 claude-3-sonnet, claude-3-haiku 등

# 하드웨어 설정 (LLM_PROVIDER=local일 때 사용)
THREADS=4                # CPU 쓰레드 수 (권장: 물리적 코어 수)
METAL_LAYERS=32          # Metal 가속 설정 (Mac의 경우)
GPU_LAYERS=33            # CUDA 가속 설정 (NVIDIA GPU의 경우)

# 타임아웃 설정
MCP_SERVER_TIMEOUT=300   # MCP 서버 요청 타임아웃(초)
LLAMA_SERVER_TIMEOUT=120 # Llama.cpp 서버 요청 타임아웃(초)

# 모델 설정 (LLM_PROVIDER=local일 때 사용)
MODEL_PATH=/models/gemma-3-27b-it-q4_0.gguf

# Docker 내부 통신용 URL (Docker Compose 사용 시)
# 이 섹션은 Docker 내에서 자동으로 사용됩니다. 수정하지 마세요.
LLAMA_SERVER_URL=http://llama-server:5602
QDRANT_URL=http://qdrant:6333
SEARXNG_URL=http://searxng:8080
MCP_SERVER_URL=http://mcp-server:5601

# 로컬 개발 환경에서의 URL (Docker를 사용하지 않을 경우)
# LOCAL_LLAMA_SERVER_URL=http://localhost:5602
# LOCAL_QDRANT_URL=http://localhost:5600
# LOCAL_SEARXNG_URL=http://localhost:5578
# LOCAL_MCP_SERVER_URL=http://localhost:5601

# Discord 봇 명령어 접두사
BOT_PREFIX=/